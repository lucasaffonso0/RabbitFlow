# As conexões com o RabbitMQ são cadastradas na aplicação (menu do usuário → Conexões).

PORT=4100

# Sessão de login: validade em dias (renova com o uso)
SESSION_DAYS=7
# Prazo máximo da sessão, mesmo com uso contínuo
SESSION_MAX_DAYS=30
# 1 se o RabbitFlow for acessado por HTTPS (atrás de um proxy reverso)
COOKIE_SECURE=0
# 1 se houver proxy reverso na frente (usa X-Forwarded-For para o limite de tentativas de login)
TRUST_PROXY=0
# Chave que criptografa as senhas das conexões no banco (texto longo e aleatório).
# Se vazia, é gerada uma vez em <DATA_DIR>/secret.key — faça backup dela junto com o banco.
# RABBITFLOW_SECRET_KEY=

# Pasta do banco SQLite no npm run dev (padrão: data/ na raiz do projeto; no container é o volume /data)
# DATA_DIR=/caminho/absoluto/data
