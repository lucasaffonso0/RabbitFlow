{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=../.env src/index.ts",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "cli": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --env-file-if-exists=../.env src/cli.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.2"
  }
}
